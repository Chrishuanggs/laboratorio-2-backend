{
  "realm": "tienda",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      {
        "name": "SUPER-ADMIN-ROLE",
        "description": "Administrador: puede hacer todo y de todo"
      },
      {
        "name": "USER",
        "description": "Usuario de la tienda o comprador."
      }
    ]
  },
  "clients": [
    {
      "clientId": "persistencia-api",
      "name": "API de Persistencia (Spring Boot)",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:*", "https://oauth.pstmn.io/v1/callback"],
      "webOrigins": ["+"],
      "fullScopeAllowed": true
    },
    {
      "clientId": "persistencia-admin",
      "name": "Cliente de servicio para registrar y listar usuarios",
      "enabled": true,
      "publicClient": false,
      "secret": "persistencia-admin-secret",
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@tienda.local",
      "emailVerified": true,
      "firstName": "Super",
      "lastName": "Admin",
      "credentials": [{ "type": "password", "value": "admin123", "temporary": false }],
      "realmRoles": ["SUPER-ADMIN-ROLE"]
    },
    {
      "username": "chris",
      "enabled": true,
      "email": "chris@tienda.local",
      "emailVerified": true,
      "firstName": "Chris",
      "lastName": "User",
      "credentials": [{ "type": "password", "value": "user123", "temporary": false }],
      "realmRoles": ["USER"]
    },
    {
      "username": "service-account-persistencia-admin",
      "enabled": true,
      "serviceAccountClientId": "persistencia-admin",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users", "query-users", "view-realm"]
      }
    }
  ]
}
